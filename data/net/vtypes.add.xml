<additional>
    <!-- Civilian mix: two-wheeler heavy, typical of Indian cities. Lengths in metres. -->
    <vTypeDistribution id="civilian">
        <vType id="car" vClass="passenger" length="4.2" width="1.7" accel="2.4" decel="4.5" sigma="0.5" speedDev="0.1" probability="0.50"/>
        <vType id="motorcycle" vClass="motorcycle" length="2.0" width="0.8" minGap="1.2" accel="3.0" decel="5.0" sigma="0.5" speedDev="0.15" probability="0.33"/>
        <vType id="bus" vClass="bus" length="11.0" width="2.5" accel="1.2" decel="4.0" sigma="0.4" speedDev="0.05" probability="0.07"/>
        <vType id="truck" vClass="truck" length="8.5" width="2.4" accel="1.1" decel="4.0" sigma="0.4" speedDev="0.05" probability="0.10"/>
    </vTypeDistribution>
    <!-- Emergency vehicles obey signals here: priority has to come from the controller,
         otherwise the radius would have no measurable effect. -->
    <vType id="ambulance" vClass="emergency" guiShape="emergency" length="5.5" width="2.0" accel="2.8" decel="5.0" sigma="0.1" minGap="1.5" speedFactor="1.3" lcStrategic="1" lcSpeedGain="8" lcKeepRight="0" color="1,1,1"/>
    <vType id="fire_engine" vClass="emergency" guiShape="firebrigade" length="8.0" width="2.4" accel="1.8" decel="4.5" sigma="0.1" minGap="1.5" speedFactor="1.2" lcStrategic="1" lcSpeedGain="8" lcKeepRight="0" color="1,0,0"/>
    <vType id="police" vClass="emergency" guiShape="police" length="4.6" width="1.8" accel="3.2" decel="5.5" sigma="0.1" minGap="1.5" speedFactor="1.35" lcStrategic="1" lcSpeedGain="8" lcKeepRight="0" color="0,0,1"/>
</additional>
